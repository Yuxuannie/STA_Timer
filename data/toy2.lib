          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "0.0370, 0.0450, 0.0750", \
            "0.0520, 0.0600, 0.0900", \
            "0.1120, 0.1200, 0.1500" );
        }
        fall_transition (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "0.0470, 0.0550, 0.0850", \
            "0.0620, 0.0700, 0.1000", \
            "0.1220, 0.1300, 0.1600" );
        }
      }
    }
  }
  cell (NAND2) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.0020;
    }
    pin (B) {
      direction : input;
      capacitance : 0.0020;
    }
    pin (Y) {
      direction : output;
      function : "!(A&B)";
      timing () {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "1.8700, 1.9500, 2.2500", \
            "2.0200, 2.1000, 2.4000", \
            "2.6200, 2.7000, 3.0000" );
        }
        cell_fall (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "1.8700, 1.9500, 2.2500", \
            "2.0200, 2.1000, 2.4000", \
            "2.6200, 2.7000, 3.0000" );
        }
        rise_transition (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "0.0370, 0.0450, 0.0750", \
            "0.0520, 0.0600, 0.0900", \
            "0.1120, 0.1200, 0.1500" );
        }
        fall_transition (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "0.0370, 0.0450, 0.0750", \
            "0.0520, 0.0600, 0.0900", \
            "0.1120, 0.1200, 0.1500" );
        }
      }
      timing () {
        related_pin : "B";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "1.8700, 1.9500, 2.2500", \
            "2.0200, 2.1000, 2.4000", \
            "2.6200, 2.7000, 3.0000" );
        }
        cell_fall (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "1.8700, 1.9500, 2.2500", \
