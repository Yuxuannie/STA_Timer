      timing () {
        related_pin : "CK";
        timing_type : hold_rising;
        rise_constraint (cons_3x3) {
          index_1 ("0.01, 0.05, 0.2");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "-0.0200, 0.0600, 0.3600", \
            "0.0200, 0.1000, 0.4000", \
            "0.1700, 0.2500, 0.5500" );
        }
        fall_constraint (cons_3x3) {
          index_1 ("0.01, 0.05, 0.2");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "-0.0200, 0.0600, 0.3600", \
            "0.0200, 0.1000, 0.4000", \
            "0.1700, 0.2500, 0.5500" );
        }
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () {
        related_pin : "CK";
        timing_type : rising_edge;
        timing_sense : non_unate;
        cell_rise (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "1.0000, 1.0000, 1.0000", \
            "1.0000, 1.0000, 1.0000", \
            "1.0000, 1.0000, 1.0000" );
        }
        cell_fall (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "1.0000, 1.0000, 1.0000", \
            "1.0000, 1.0000, 1.0000", \
            "1.0000, 1.0000, 1.0000" );
        }
        rise_transition (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "0.0500, 0.0500, 0.0500", \
            "0.0500, 0.0500, 0.0500", \
            "0.0500, 0.0500, 0.0500" );
        }
        fall_transition (del_3x3) {
          index_1 ("0.001, 0.004, 0.016");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "0.0500, 0.0500, 0.0500", \
            "0.0500, 0.0500, 0.0500", \
            "0.0500, 0.0500, 0.0500" );
        }
      }
    }
  }
