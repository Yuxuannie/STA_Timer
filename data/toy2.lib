  cell (DFF) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.0010;
    }
    pin (D) {
      direction : input;
      capacitance : 0.0020;
      timing () {
        related_pin : "CK";
        timing_type : setup_rising;
        rise_constraint (cons_3x3) {
          index_1 ("0.01, 0.05, 0.2");
          index_2 ("0.01, 0.05, 0.2");
          values ( \
            "0.2600, 0.2800, 0.3550", \
            "0.2800, 0.3000, 0.3750", \
            "0.3550, 0.3750, 0.4500" );
        }
        fall_constraint (cons_3x3) {
