# s1423 (ISCAS-89, converted by tools/bench2v.py): one ideal clock, every PI and PO constrained.
# Slews and loads sit on toy2.lib grid points (0.05 ns, 0.004 pF).
create_clock -name clk -period 75.6 [get_ports clk]
set_clock_transition 0.05 [get_clocks clk]
set_input_delay 0.5 -clock clk [get_ports G0]
set_input_delay 0.5 -clock clk [get_ports G1]
set_input_delay 0.5 -clock clk [get_ports G2]
set_input_delay 0.5 -clock clk [get_ports G3]
set_input_delay 0.5 -clock clk [get_ports G4]
set_input_delay 0.5 -clock clk [get_ports G5]
set_input_delay 0.5 -clock clk [get_ports G6]
set_input_delay 0.5 -clock clk [get_ports G7]
set_input_delay 0.5 -clock clk [get_ports G8]
set_input_delay 0.5 -clock clk [get_ports G9]
set_input_delay 0.5 -clock clk [get_ports G10]
set_input_delay 0.5 -clock clk [get_ports G11]
set_input_delay 0.5 -clock clk [get_ports G12]
set_input_delay 0.5 -clock clk [get_ports G13]
set_input_delay 0.5 -clock clk [get_ports G14]
set_input_delay 0.5 -clock clk [get_ports G15]
set_input_delay 0.5 -clock clk [get_ports G16]
set_input_transition 0.05 [get_ports G0]
set_input_transition 0.05 [get_ports G1]
set_input_transition 0.05 [get_ports G2]
set_input_transition 0.05 [get_ports G3]
set_input_transition 0.05 [get_ports G4]
set_input_transition 0.05 [get_ports G5]
set_input_transition 0.05 [get_ports G6]
set_input_transition 0.05 [get_ports G7]
set_input_transition 0.05 [get_ports G8]
set_input_transition 0.05 [get_ports G9]
set_input_transition 0.05 [get_ports G10]
set_input_transition 0.05 [get_ports G11]
set_input_transition 0.05 [get_ports G12]
set_input_transition 0.05 [get_ports G13]
set_input_transition 0.05 [get_ports G14]
set_input_transition 0.05 [get_ports G15]
set_input_transition 0.05 [get_ports G16]
set_output_delay 0.5 -clock clk [get_ports G726]
set_output_delay 0.5 -clock clk [get_ports G729]
set_output_delay 0.5 -clock clk [get_ports G702]
set_output_delay 0.5 -clock clk [get_ports G727]
set_output_delay 0.5 -clock clk [get_ports G701BF]
set_load 0.004 [get_ports G726]
set_load 0.004 [get_ports G729]
set_load 0.004 [get_ports G702]
set_load 0.004 [get_ports G727]
set_load 0.004 [get_ports G701BF]
